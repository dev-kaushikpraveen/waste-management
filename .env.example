# EcoTrace 360 Environment Variables
PROJECT_NAME="EcoTrace 360"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to SQLite for instant local operation, PostgreSQL in Docker)
DATABASE_URL="sqlite:///./ecotrace360.db"
# DATABASE_URL="postgresql://ecotrace:ecotrace_pass@localhost:5432/ecotrace360"

# MQTT Broker Settings
MQTT_BROKER="localhost"
MQTT_PORT=1883
MQTT_USER="ecotrace"
MQTT_PASSWORD="ecotrace_secret"

# Frontend Vite Port
PORT=3000
